---
import Site from '../layouts/Site.astro';
import Download from '../components/Download.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { BookOpen, Layers2, Gem, ArrowUpRight } from 'lucide-react';
import { visibleArticles } from '../features/articles/public';
const articles = visibleArticles();
const featured = [
  {
    slug: 'how-to-identify-quartz',
    title: 'Quartz',
    summary: 'Crystal shapes, surface clues and common lookalikes.',
  },
  {
    slug: 'how-to-identify-amethyst',
    title: 'Amethyst',
    summary: 'Look beyond purple. Know which clues to compare.',
  },
  {
    slug: 'how-to-identify-obsidian',
    title: 'Obsidian',
    summary: 'A closer look at glassy black stones.',
  },
].flatMap((item) =>
  articles
    .filter((article) => article.content.slug === item.slug)
    .map((article) => ({ ...item, content: article.content })),
);
const paths = [
  {
    title: 'Stone guides',
    description: 'Learn the clues in rocks and minerals.',
    href: '/guides',
    Icon: BookOpen,
  },
  {
    title: 'Compare stones',
    description: 'Explore key differences side by side.',
    href: '/comparisons',
    Icon: Layers2,
  },
  {
    title: 'Jewelry guides',
    description: 'Understand gemstones and jewelry marks.',
    href: '/jewelry',
    Icon: Gem,
  },
];
---

<Site title="Rock, mineral & jewelry identification guides">
  <div class="home-content">
    <section class="discovery-hero">
      <div class="discovery-copy">
        <h1>
          Know the <span>stone</span>
          <br />
          in your hand.
        </h1>
        <p>
          Practical guides for rocks, minerals and jewelry. Explore possible matches with our iPhone
          app.
        </p>
        <div class="hero-actions">
          <Download placement="hero" badge />
          <a class="button secondary" href="/guides">
            Browse guides <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="store-name">Rock Scan: Jewelry Identifier on the App Store.</p>
      </div>
      <figure class="specimen-feature">
        <img
          src="/images/quartz.jpg"
          alt="Natural quartz crystal cluster from Minas Gerais, Brazil"
          width="1280"
          height="1090"
          fetchpriority="high"
        />
        <figcaption>
          Quartz · Natural crystal specimen <a href="/credits">Photo credits ↗</a>
        </figcaption>
      </figure>
    </section>
    <nav class="discovery-paths" aria-label="Explore by topic">
      {paths.map(({ title, description, href, Icon }) => (
        <a href={href}>
          <Icon size={26} strokeWidth={1.6} aria-hidden="true" />
          <div>
            <strong>{title}</strong>
            <span>{description}</span>
          </div>
          <ArrowUpRight size={19} aria-hidden="true" />
        </a>
      ))}
    </nav>
    <section class="home-guides">
      <div class="home-section-heading">
        <h2>Find your next guide</h2>
        <a href="/guides">
          View all guides <span aria-hidden="true">↗</span>
        </a>
      </div>
      {featured.length ? (
        <div class="article-grid">
          {featured.map((item) => (
            <ArticleCard
              content={item.content}
              displayTitle={item.title}
              summary={item.summary}
              compact
            />
          ))}
        </div>
      ) : (
        <p>Our first guides are in preparation. Explore the app while we finish them.</p>
      )}
    </section>
    <section class="home-app-callout">
      <img
        class="app-icon"
        src="/images/app-icon.jpg"
        alt="Rock Scan app icon"
        width="64"
        height="64"
      />
      <div>
        <h2>Your next discovery starts with a photo.</h2>
        <p>Explore possible matches for your stone in the iPhone app.</p>
      </div>
      <Download placement="footer" label="Open in App Store" />
    </section>
    <p class="worksheet-link">
      Prefer to start with observations?{' '}
      <a href="/identification-checklist">Get the free printable worksheet ↗</a>
    </p>
  </div>
</Site>
