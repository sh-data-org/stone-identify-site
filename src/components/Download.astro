---
interface Props {
  placement?: string;
  label?: string;
  secondary?: boolean;
  badge?: boolean;
  from?: string;
}
const { label = 'Open in App Store', secondary = false, badge = false } = Astro.props;
const link = 'https://apps.apple.com/us/app/id6782013876';
---

<a
  class:list={[{ button: !badge, secondary, 'store-badge': badge }]}
  href={link}
  aria-label={badge ? 'Download on the App Store' : undefined}
>
  {badge ? (
    <img src="/app-store-badge.svg" alt="Download on the App Store" width="180" height="60" />
  ) : (
    <>
      {label}
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M4 12h16m-6-6 6 6-6 6" />
      </svg>
    </>
  )}
</a>
