---
import { categories, type ArticleContent } from '../features/articles/schema';
interface Props {
  content: ArticleContent;
  index?: number;
  displayTitle?: string;
  summary?: string;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const {
  content,
  index,
  headingLevel: Heading = 'h3',
  displayTitle,
  summary,
  compact = false,
} = Astro.props;
---

<a
  class:list={['article-card', { 'compact-card': compact }]}
  href={`/${content.category}/${content.slug}`}
>
  <div class="card-image">
    {content.image && (
      <img
        src={content.image.path}
        alt={content.image.alt}
        width="640"
        height="480"
        loading="lazy"
      />
    )}
    {index !== undefined && <span class="card-number">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <div class="card-copy">
    {!compact && <span class="eyebrow">{categories[content.category]}</span>}
    <Heading>{displayTitle || content.title}</Heading>
    <p>{summary || content.description}</p>
    <span class="text-link" aria-hidden={compact ? 'true' : undefined}>
      {!compact && 'Read the guide'} <span aria-hidden="true">↗</span>
    </span>
  </div>
</a>
